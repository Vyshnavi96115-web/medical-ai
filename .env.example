# Hugging Face Access Token for MedGemma Model Inference
HF_TOKEN=your_hugging_face_token_here

# Verified MedGemma Model Identifier (e.g. google/medgemma-1.5-4b-it)
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it

# Optional Custom MedGemma Inference Endpoint URL (if using dedicated inference endpoint or vLLM)
# MEDGEMMA_ENDPOINT_URL=https://your-dedicated-inference-endpoint-url

# Flask Secret Key for Production Session Management
SECRET_KEY=your_production_secret_key_here

# Application Environment
FLASK_ENV=production
